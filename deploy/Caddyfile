thekickback.net {
	# Wallet service endpoints
	handle /wallet/* {
		reverse_proxy wallet-service:3003
	}

	# Everything else → landing page
	handle {
		reverse_proxy landing-blue:3000
	}
}

join.thekickback.net {
	header Cache-Control "no-store, no-cache, must-revalidate"
	header CDN-Cache-Control "no-store"
	header Cloudflare-CDN-Cache-Control "no-store"
	reverse_proxy join-app:3000
}



dash.thekickback.net {
	reverse_proxy dash-app:3000
}

sanddash.thekickback.net {
	reverse_proxy dash-app:3000
}

claw.thekickback.net {
	reverse_proxy claw:18789
}

sandbox.thekickback.net {
	header Cache-Control "no-store, no-cache, must-revalidate"
	header CDN-Cache-Control "no-store"
	header Cloudflare-CDN-Cache-Control "no-store"
	reverse_proxy join-app:3000
}
